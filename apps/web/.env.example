# ─────────────────────────────────────────────────────────────────────
# Naprocs EMS — Frontend Web Environment Variables
# apps/web/.env.example
# NEVER commit real values to the repository.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser bundle.
# ─────────────────────────────────────────────────────────────────────

# ── NEXTAUTH ─────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000           # P1 | https://ems.naprocs.internal in prod
NEXTAUTH_SECRET=REPLACE_WITH_MIN_32_CHAR_RANDOM_STRING          # P1

# ── API CONNECTION ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1   # P1 | https://api.naprocs.internal/api/v1 in prod
NEXT_PUBLIC_WS_URL=ws://localhost:3001             # P1 | wss://api.naprocs.internal in prod

# ── APP ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Naprocs EMS             # P1

# ── FEATURE FLAGS (must match API values) ────────────────────────────
NEXT_PUBLIC_PHASE_2_ENABLED=false            # P1 | read at build time — updated via enable-phase2.sh
NEXT_PUBLIC_PHASE_3_ENABLED=false            # P1 | read at build time — updated via enable-phase3.sh

# ── SENTRY ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=http://REPLACE@sentry.naprocs.internal/1 # P1

# ── AWS CLOUDFRONT ───────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDFRONT_DOMAIN=REPLACE.cloudfront.net            # P1

# ── UPLOADS ──────────────────────────────────────────────────────────
NEXT_PUBLIC_MAX_UPLOAD_SIZE=10485760         # P1 | 10MB in bytes
