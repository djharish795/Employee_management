# Copy to .env.local for local Docker Postgres + Redis (see docker-compose.yml at repo root).
# Staging values stay in .env; .env.local overrides when present if you load it manually,
# or merge these into .env while developing offline.

DATABASE_URL=postgresql://naprocs:naprocs_local_dev@localhost:5432/naprocs_ems?schema=public
DATABASE_DIRECT_URL=postgresql://naprocs:naprocs_local_dev@localhost:5432/naprocs_ems?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS=false
REDIS_PASSWORD=
