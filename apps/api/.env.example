# ─────────────────────────────────────────────────────────────────────
# Naprocs EMS — Backend API Environment Variables
# apps/api/.env.example
# Phase labels: P1 = needed from Day 1 | P2 = needed when PHASE_2_ENABLED=true
#               P3 = needed when PHASE_3_ENABLED=true
# All secrets must be stored in AWS Secrets Manager in production.
# NEVER commit real values to the repository.
# ─────────────────────────────────────────────────────────────────────

# ── APP ──────────────────────────────────────────────────────────────
NODE_ENV=development                          # P1 | production | staging | development
PORT=3001                                     # P1 | NestJS server port
API_VERSION=v1                                # P1 | all routes prefixed /api/v1

# ── DATABASE (PostgreSQL RDS) ────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/naprocs_ems?sslmode=disable    # P1
DATABASE_DIRECT_URL=postgresql://user:pass@localhost:5432/naprocs_ems             # P1 | for Prisma migrations (bypasses PgBouncer)
DATABASE_POOL_MIN=2                           # P1 | minimum connection pool size
DATABASE_POOL_MAX=10                          # P1 | maximum connection pool size

# ── REDIS (AWS ElastiCache) ──────────────────────────────────────────
REDIS_HOST=localhost                          # P1 | ElastiCache primary endpoint in prod
REDIS_PORT=6379                              # P1 | use 6380 for TLS in prod
REDIS_TLS=false                              # P1 | set true in prod (ElastiCache in-transit encryption)
REDIS_PASSWORD=                              # P1 | ElastiCache auth token from Secrets Manager

# ── JWT / AUTH ───────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_MIN_64_CHAR_RANDOM_STRING              # P1 | from Secrets Manager in prod
JWT_ACCESS_EXPIRES=15m                        # P1 | short-lived access tokens
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_STRING       # P1 | separate secret for refresh tokens
JWT_REFRESH_EXPIRES=7d                        # P1 | refresh token lifetime
MFA_TOTP_ISSUER=Naprocs EMS                  # P1 | shown in Google Authenticator
SESSION_MAX_CONCURRENT=3                      # P1 | max concurrent sessions per user

# ── AWS ──────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1                        # P1 | Mumbai — DPDPA compliant
AWS_ACCESS_KEY_ID=REPLACE_WITH_IAM_KEY       # P1 | use IAM role on ECS in prod — do not hardcode
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_IAM_SECRET # P1
AWS_S3_BUCKET=naprocs-ems-documents-dev      # P1 | naprocs-ems-documents-prod in prod
AWS_S3_SIGNED_URL_EXPIRY=900                 # P1 | 900 seconds = 15 minutes
AWS_SES_FROM_EMAIL=noreply@naprocs.in        # P1 | must be verified in SES
AWS_SES_REGION=ap-south-1                    # P1
AWS_CLOUDFRONT_DOMAIN=REPLACE_WITH_CF_DOMAIN # P1 | xxxxxx.cloudfront.net
AWS_CLOUDFRONT_KEY_PAIR_ID=REPLACE_WITH_KEY_PAIR_ID  # P1 | for signed URLs

# ── DATA ENCRYPTION (AES-256-GCM) ───────────────────────────────────
# Used for: Aadhaar, PAN, bank account numbers, phone numbers
FIELD_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_KEY              # P1 | 64 hex chars = 32 bytes
FIELD_ENCRYPTION_IV_LENGTH=16                # P1 | IV length for AES-GCM

# ── FEATURE FLAGS (Phase gating) ─────────────────────────────────────
# NEVER set these to true manually — use infra/scripts/enable-phase2.sh
# and infra/scripts/enable-phase3.sh which also run migrations safely
PHASE_2_ENABLED=false                        # P1 | flip to true only via enable-phase2.sh
PHASE_3_ENABLED=false                        # P1 | flip to true only via enable-phase3.sh

# ── SENTRY (Error tracking — self-hosted) ────────────────────────────
SENTRY_DSN=http://REPLACE@sentry.naprocs.internal/1             # P1 | self-hosted EC2 t3.small
SENTRY_ENVIRONMENT=development               # P1 | production | staging | development

# ── RATE LIMITING ────────────────────────────────────────────────────
THROTTLE_TTL_GLOBAL=60000                    # P1 | global window in ms (60 seconds)
THROTTLE_LIMIT_GLOBAL=100                    # P1 | requests per window per IP
THROTTLE_LOGIN_TTL=900000                    # P1 | 15 min window for login endpoint
THROTTLE_LOGIN_LIMIT=5                       # P1 | max 5 login attempts per 15 min per IP
THROTTLE_OTP_TTL=3600000                     # P1 | 1 hour OTP send window
THROTTLE_OTP_LIMIT=3                         # P1 | max 3 OTP sends per hour per email

# ── WEBSOCKET ────────────────────────────────────────────────────────
WS_CORS_ORIGIN=http://localhost:3000         # P1 | https://ems.naprocs.internal in prod

# ── PAYROLL / BANKING (Phase 2 only) ────────────────────────────────
# These variables are NOT READ until PHASE_2_ENABLED=true
PAYROLL_NEFT_BANK_NAME=HDFC Bank            # P2 | company salary account bank
PAYROLL_NEFT_ACCOUNT_NUMBER=REPLACE         # P2 | company salary account number
PAYROLL_NEFT_IFSC=REPLACE                   # P2 | company bank IFSC code

# ── RAZORPAY X (Phase 3 only — automated disbursement if approved) ───
# These variables are NOT READ until PHASE_3_ENABLED=true and client approves
PAYROLL_RAZORPAYX_KEY=REPLACE               # P3 | Razorpay X (Payouts API) key only
PAYROLL_RAZORPAYX_SECRET=REPLACE            # P3 | NOT standard Razorpay gateway

# ── AI / CLAUDE (Phase 3 only) ───────────────────────────────────────
# These variables are NOT READ until PHASE_3_ENABLED=true
ANTHROPIC_API_KEY=REPLACE                   # P3 | Claude API key for AI modules only
OPENAI_API_KEY=REPLACE                      # P3 | for embedding generation (optional)
AI_MODEL=claude-sonnet-4-6                  # P3 | model string
AI_MAX_TOKENS=4096                          # P3
