model TelemetryLog {
  id          String   @id @default(cuid())
  employeeId  String
  userId      String
  page        String
  action      String   @default("VIEW")
  ipAddress   String
  internetIp  String
  deviceData  Json?
  timeSpentMs Int?
  timestamp   DateTime @default(now())
  employee    Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([timestamp])
  @@index([page])
}

model AnomalyEvent {
  id         String   @id @default(cuid())
  employeeId String?
  type       String
  severity   String
  details    Json
  timestamp  DateTime @default(now())

  @@index([type])
  @@index([timestamp])
}
