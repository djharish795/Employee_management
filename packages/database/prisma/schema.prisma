// Naprocs EMS — Prisma Schema Skeleton
// All models defined upfront for all three phases.
// Phase 1 migrations: 0001_p1_ prefix
// Phase 2 migrations: 0020_p2_ prefix
// Phase 3 migrations: 0040_p3_ prefix
// DO NOT implement field types yet. Skeleton only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// PHASE 1 MODELS
// ─────────────────────────────────────────

model Employee {
  // id
  // employeeId
  // firstName
  // middleName
  // lastName
  // preferredName
  // officialEmail
  // personalEmail
  // phone (AES-256-GCM encrypted)
  // aadhaar (AES-256-GCM encrypted)
  // pan (AES-256-GCM encrypted)
  // passport (AES-256-GCM encrypted)
  // dateOfBirth
  // gender
  // bloodGroup
  // nationality
  // maritalStatus
  // currentAddress
  // permanentAddress
  // emergencyContact
  // departmentId -> Department
  // designationId -> Designation
  // reportingManagerId -> Employee (self-relation)
  // skipLevelManagerId -> Employee (self-relation)
  // workLocation
  // employeeType
  // grade
  // band
  // joiningDate
  // status
  // exitDate
  // exitReason
  // backgroundVerified
  // digitalSignature
  // photoUrl
  // searchVector (pg_trgm tsvector)
  // createdAt
  // updatedAt
}

model Department {
  // id
  // name
  // code
  // headId -> Employee
  // parentDepartmentId -> Department (self-relation)
  // createdAt
  // updatedAt
}

model Designation {
  // id
  // title
  // departmentId -> Department
  // grade
  // band
  // createdAt
}

model User {
  // id
  // employeeId -> Employee
  // email
  // passwordHash
  // isActive
  // lastLoginAt
  // createdAt
}

model Session {
  // id
  // userId -> User
  // deviceId -> Device
  // token (Redis key reference)
  // ipAddress
  // userAgent
  // expiresAt
  // createdAt
}

model Device {
  // id
  // userId -> User
  // fingerprint
  // name
  // isTrusted
  // trustedAt
  // lastSeenAt
  // createdAt
}

model OTPVerification {
  // id
  // userId -> User
  // code (hashed)
  // type (EMAIL_OTP | TOTP)
  // expiresAt
  // usedAt
  // createdAt
}

model AttendanceRecord {
  // id
  // employeeId -> Employee
  // date
  // checkInTime
  // checkOutTime
  // workHours
  // overtime
  // status
  // checkInMethod
  // ipAddress
  // isRegularized
  // regularizedBy -> Employee
  // notes
  // createdAt
}

model LeaveType {
  // id
  // name
  // code
  // maxDays
  // isCarryForwardAllowed
  // maxCarryForwardDays
  // isPaidLeave
  // createdAt
}

model LeaveBalance {
  // id
  // employeeId -> Employee
  // leaveTypeId -> LeaveType
  // year
  // allocated
  // used
  // pending
  // remaining
  // updatedAt
}

model LeaveRequest {
  // id
  // employeeId -> Employee
  // leaveTypeId -> LeaveType
  // startDate
  // endDate
  // totalDays
  // reason
  // status
  // appliedAt
  // approverId -> Employee
  // approvedAt
  // rejectionReason
  // workflowId -> Workflow
}

model Asset {
  // id
  // assetTag
  // name
  // category (LAPTOP | DESKTOP | MOBILE | SIM | ACCESS_CARD | LICENSE | OTHER)
  // brand
  // model
  // serialNumber
  // purchaseDate
  // purchaseCost
  // status (AVAILABLE | ASSIGNED | LOST | DAMAGED | RETIRED)
  // assignedTo -> Employee
  // assignedAt
  // returnedAt
  // notes
  // createdAt
  // updatedAt
}

model AssetAssignment {
  // id
  // assetId -> Asset
  // employeeId -> Employee
  // assignedAt
  // returnedAt
  // returnedCondition
  // assignedBy -> Employee
  // notes
}

model Notification {
  // id
  // recipientId -> Employee
  // type
  // title
  // body
  // data (JSON)
  // isRead
  // readAt
  // createdAt
}

model Workflow {
  // id
  // name
  // type (LEAVE | ASSET_REQUEST | RECRUITMENT | PROMOTION | OFFBOARDING)
  // steps (JSON - array of step definitions)
  // isActive
  // createdAt
  // updatedAt
}

model WorkflowInstance {
  // id
  // workflowId -> Workflow
  // resourceType
  // resourceId
  // currentStepIndex
  // status (PENDING | IN_PROGRESS | APPROVED | REJECTED | CANCELLED)
  // initiatedBy -> Employee
  // createdAt
  // updatedAt
}

model KnowledgeDoc {
  // id
  // title
  // slug
  // category (POLICY | SOP | ARCHITECTURE | HR_GUIDELINES | TRAINING)
  // content
  // authorId -> Employee
  // isPublished
  // publishedAt
  // createdAt
  // updatedAt
}

model AuditLog {
  // id (append-only — NEVER update or delete)
  // actorId -> Employee
  // action
  // resource
  // resourceId
  // oldValue (JSON)
  // newValue (JSON)
  // ipAddress
  // deviceId
  // userAgent
  // requestId
  // performedAt
}

model ConsentLog {
  // id
  // employeeId -> Employee
  // purpose
  // consentedAt
  // revokedAt
  // collectedBy -> Employee
  // ipAddress
  // notes
}

model DataErasureRequest {
  // id
  // employeeId -> Employee
  // requestedAt
  // requestedBy -> Employee
  // status (PENDING | APPROVED | PROCESSING | COMPLETED | REJECTED)
  // approvedBy -> Employee
  // approvedAt
  // processedAt
  // fieldsErased (JSON)
  // notes
}

model GrievanceCase {
  // id
  // employeeId -> Employee
  // description
  // officerId -> Employee (grievance officer)
  // status (OPEN | IN_PROGRESS | RESOLVED | CLOSED)
  // resolution
  // openedAt
  // resolvedAt
}

model AppSetting {
  // id
  // key
  // value
  // category
  // updatedBy -> Employee
  // updatedAt
}

// ─────────────────────────────────────────
// PHASE 2 MODELS
// ─────────────────────────────────────────

model SalaryStructure {
  // id
  // employeeId -> Employee
  // ctc
  // basic
  // hra
  // specialAllowance
  // pfEligible
  // esiEligible
  // effectiveFrom
  // createdBy -> Employee
  // createdAt
}

model PayrollRun {
  // id
  // month
  // year
  // status (PENDING | PROCESSING | COMPLETED | FAILED)
  // startedAt
  // completedAt
  // failedAt
  // failureReason
  // processedCount
  // totalAmount
  // bankFileName
  // initiatedBy -> Employee
  // @@unique([month, year]) — prevents double run
}

model PayrollLineItem {
  // id
  // payrollRunId -> PayrollRun
  // employeeId -> Employee
  // grossSalary
  // basicSalary
  // hra
  // specialAllowance
  // pfEmployee
  // pfEmployer
  // esi
  // professionalTax
  // tds
  // totalDeductions
  // netSalary
  // bankAccount (AES encrypted)
  // ifscCode
  // status (PENDING | PROCESSED | FAILED)
  // payslipUrl
}

model Reimbursement {
  // id
  // employeeId -> Employee
  // category
  // amount
  // description
  // receiptUrl
  // status (PENDING | APPROVED | REJECTED | PAID)
  // approverId -> Employee
  // payrollRunId -> PayrollRun
  // createdAt
}

model Job {
  // id
  // title
  // departmentId -> Department
  // hiringManagerId -> Employee
  // jobDescription
  // requiredSkills (JSON array)
  // minExperience
  // maxExperience
  // ctcMin
  // ctcMax
  // openPositions
  // filledPositions
  // status (DRAFT | OPEN | CLOSED | ON_HOLD)
  // targetDate
  // createdAt
}

model Candidate {
  // id
  // jobId -> Job
  // name
  // email
  // phone
  // resumeUrl
  // currentStage (APPLIED | SCREENING | INTERVIEW | OFFER | JOINED | REJECTED)
  // sourceChannel
  // skills (JSON array)
  // currentCTC
  // expectedCTC
  // noticePeriod
  // appliedAt
  // updatedAt
}

model Interview {
  // id
  // candidateId -> Candidate
  // jobId -> Job
  // interviewerId -> Employee
  // scheduledAt
  // type (PHONE | VIDEO | IN_PERSON | TECHNICAL | HR)
  // status (SCHEDULED | COMPLETED | CANCELLED | NO_SHOW)
  // feedback
  // rating
  // recommendation (STRONG_YES | YES | NO | STRONG_NO)
  // completedAt
}

model Offer {
  // id
  // candidateId -> Candidate
  // jobId -> Job
  // offeredCTC
  // joiningDate
  // status (DRAFT | SENT | ACCEPTED | REJECTED | EXPIRED)
  // offerLetterUrl
  // sentAt
  // respondedAt
  // expiresAt
}

model Goal {
  // id
  // employeeId -> Employee
  // title
  // description
  // type (OKR | KPI | PERSONAL)
  // weight
  // targetValue
  // currentValue
  // unit
  // dueDate
  // status (NOT_STARTED | IN_PROGRESS | COMPLETED | MISSED)
  // reviewCycleId -> ReviewCycle
  // createdAt
}

model ReviewCycle {
  // id
  // name
  // type (QUARTERLY | HALF_YEARLY | ANNUAL)
  // year
  // quarter
  // startDate
  // endDate
  // status (UPCOMING | ACTIVE | COMPLETED)
  // createdAt
}

model PerformanceReview {
  // id
  // employeeId -> Employee
  // reviewCycleId -> ReviewCycle
  // reviewerId -> Employee
  // type (SELF | MANAGER | PEER | SKIP_LEVEL)
  // status (PENDING | SUBMITTED | ACKNOWLEDGED)
  // overallRating
  // feedback
  // submittedAt
  // acknowledgedAt
}

model Skill {
  // id
  // name
  // category (TECHNICAL | SOFT | LEADERSHIP | DOMAIN)
  // subcategory
  // createdAt
}

model EmployeeSkill {
  // id
  // employeeId -> Employee
  // skillId -> Skill
  // proficiencyLevel (BEGINNER | INTERMEDIATE | ADVANCED | EXPERT)
  // yearsOfExperience
  // isVerified
  // verifiedBy -> Employee
  // updatedAt
}

model Course {
  // id
  // title
  // description
  // category
  // provider
  // durationHours
  // courseUrl
  // isInternal
  // isActive
  // createdAt
}

model Enrollment {
  // id
  // employeeId -> Employee
  // courseId -> Course
  // enrolledAt
  // completedAt
  // progressPercent
  // status (ENROLLED | IN_PROGRESS | COMPLETED | DROPPED)
  // certificateUrl
}

model Survey {
  // id
  // title
  // type (PULSE | MOOD | EXIT | ONBOARDING | CUSTOM)
  // questions (JSON array)
  // targetAudience (ALL | DEPARTMENT | TEAM)
  // isAnonymous
  // createdBy -> Employee
  // startDate
  // endDate
  // status (DRAFT | ACTIVE | CLOSED)
}

model SurveyResponse {
  // id
  // surveyId -> Survey
  // respondentId -> Employee (null if anonymous)
  // answers (JSON)
  // submittedAt
}

model Recognition {
  // id
  // fromEmployeeId -> Employee
  // toEmployeeId -> Employee
  // type (KUDOS | AWARD | BADGE)
  // title
  // message
  // isPublic
  // createdAt
}

model SuccessionPlan {
  // id
  // roleId (critical position identifier)
  // roleTitle
  // incumbentId -> Employee
  // successorId -> Employee
  // readinessLevel (READY_NOW | READY_1_YEAR | READY_2_YEARS | DEVELOPING)
  // gapAnalysis
  // developmentPlan
  // updatedAt
}

model TalentApplication {
  // id
  // employeeId -> Employee
  // jobId -> Job (internal job)
  // appliedAt
  // status (APPLIED | UNDER_REVIEW | APPROVED | REJECTED)
  // notes
}

model TransferRequest {
  // id
  // employeeId -> Employee
  // fromDepartmentId -> Department
  // toDepartmentId -> Department
  // reason
  // status (PENDING | APPROVED | REJECTED)
  // requestedAt
  // processedAt
  // processedBy -> Employee
}

// ─────────────────────────────────────────
// PHASE 3 MODELS
// ─────────────────────────────────────────

model EmbeddingVector {
  // id
  // documentId
  // documentType (KNOWLEDGE | POLICY | REVIEW | SOP)
  // chunkIndex
  // chunkText
  // embedding (vector(1536) — pgvector — added in 0040_p3_ migration)
  // model
  // createdAt
}

model AttritionRiskScore {
  // id
  // employeeId -> Employee
  // riskScore (0.0 to 1.0)
  // riskLevel (LOW | MEDIUM | HIGH | CRITICAL)
  // factors (JSON — contributing risk factors with weights)
  // recommendation
  // modelVersion
  // computedAt
  // validUntil
}

model AIInsight {
  // id
  // type (ATTRITION | SKILL_GAP | PROMOTION | FORECASTING | HIRING)
  // targetId (employeeId or departmentId)
  // targetType (EMPLOYEE | DEPARTMENT | ORGANIZATION)
  // insight (JSON)
  // confidence
  // modelVersion
  // generatedAt
  // expiresAt
}

model AIChat {
  // id
  // employeeId -> Employee
  // sessionId
  // messages (JSON array of {role, content, timestamp})
  // createdAt
  // updatedAt
}
