generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id                         String                     @id @default(cuid())
  employeeId                 String                     @unique
  firstName                  String
  lastName                   String
  officialEmail              String                     @unique
  departmentId               String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  aadhaar                    String?
  alternatePhone             String?
  backgroundVerified         Boolean                    @default(false)
  band                       String?
  bloodGroup                 String?
  currentAddress             Json?
  dateOfBirth                DateTime?
  designationId              String?
  digitalSignatureUrl        String?
  drivingLicence             String?
  emergencyContact           Json?
  employeeType               EmployeeType?              @default(FULL_TIME)
  exitDate                   DateTime?
  exitReason                 String?
  gender                     Gender?
  grade                      String?
  joiningDate                DateTime?
  maritalStatus              MaritalStatus?
  middleName                 String?
  nationality                String?                    @default("Indian")
  pan                        String?
  passport                   String?
  permanentAddress           Json?
  personalEmail              String?
  phone                      String?
  photoUrl                   String?
  preferredName              String?
  reportingManagerId         String?
  assignedHrId               String?
  skipLevelManagerId         String?
  voterId                    String?
  workLocation               String?
  status                     EmployeeStatus             @default(PROBATION)
  accountType                String?
  bankAccountEnc             String?
  bankBranch                 String?
  bankIfsc                   String?
  bankName                   String?
  documents                  Json?
  preferences                Json?
  paymentFrequency           String?
  paymentMode                String?
  aiChats                    AIChat[]
  telemetryLogs              TelemetryLog[]
  appSettingsUpdated         AppSetting[]
  assetsAssignedByMe         AssetAssignment[]          @relation("AssetAssigner")
  assetAssignments           AssetAssignment[]          @relation("AssetAssignmentEmployee")
  assetRequestsCEOApproved   AssetRequest[]             @relation("AssetRequestCEOApprover")
  assetRequestsForMe         AssetRequest[]             @relation("AssetRequestEmployee")
  assetRequestsOMApproved    AssetRequest[]             @relation("AssetRequestOMApprover")
  assetRequestsCreated       AssetRequest[]             @relation("AssetRequestCreator")
  assetsHeld                 Asset[]                    @relation("CurrentAssetHolder")
  attendanceRecords          AttendanceRecord[]
  regularizedAttendances     AttendanceRecord[]         @relation("AttendanceRegularizer")
  approvedOvertimes          AttendanceRecord[]         @relation("OvertimeApprover")
  attritionRiskScores        AttritionRiskScore[]
  auditLogEntries            AuditLog[]
  cemLeads                   CemLead[]                  @relation("CemLeadOwner")
  clientLeadsAssigned        ClientLead[]               @relation("ClientLeadOwner")
  clientLeadsAssignedCrm     ClientLead[]               @relation("ClientCrmOwner")
  compliancePoliciesUpdated  CompliancePolicy[]         @relation("PolicyUpdater")
  connectSettings            ConnectSettings?
  consentLogsCollected       ConsentLog[]               @relation("ConsentCollector")
  consentLogsAsSubject       ConsentLog[]               @relation("ConsentSubject")
  dailyWorkLogs              DailyWorkLog[]
  erasureRequestsApproved    DataErasureRequest[]       @relation("ErasureApprover")
  erasureRequestsAsSubject   DataErasureRequest[]       @relation("ErasureSubject")
  erasureRequestsMade        DataErasureRequest[]       @relation("ErasureRequester")
  headOf                     Department[]               @relation("DepartmentHead")
  employeeSkills             EmployeeSkill[]
  skillsVerified             EmployeeSkill[]            @relation("SkillVerifier")
  assignedHr                 Employee?                  @relation("AssignedHR", fields: [assignedHrId], references: [id])
  hrFor                      Employee[]                 @relation("AssignedHR")
  department                 Department?                @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  designation                Designation?               @relation(fields: [designationId], references: [id])
  reportingManager           Employee?                  @relation("ReportingManager", fields: [reportingManagerId], references: [id])
  subordinates               Employee[]                 @relation("ReportingManager")
  skipLevelManager           Employee?                  @relation("SkipLevelManager", fields: [skipLevelManagerId], references: [id])
  skipLevelOf                Employee[]                 @relation("SkipLevelManager")
  enrollments                Enrollment[]
  fieldWorkApprovals         FieldWorkRequest[]         @relation("FieldWorkApprover")
  fieldWorkRequests          FieldWorkRequest[]         @relation("FieldWorkRequester")
  goals                      Goal[]
  grievanceCasesAsSubject    GrievanceCase[]            @relation("GrievanceSubject")
  grievanceCasesAsOfficer    GrievanceCase[]            @relation("GrievanceOfficer")
  interviewsConducted        Interview[]
  jobsAsHiringManager        Job[]
  knowledgeAcknowledgements  KnowledgeAcknowledgement[]
  knowledgeDocVersions       KnowledgeDocVersion[]
  knowledgeDocsAuthored      KnowledgeDoc[]
  leaveBalances              LeaveBalance[]
  leaveRequestsToApprove     LeaveRequest[]             @relation("LeaveApprover")
  leaveRequestsMade          LeaveRequest[]             @relation("LeaveRequester")
  meetNoteComments           MeetNoteComment[]
  meetNotes                  MeetNote[]
  meetParticipations         MeetParticipant[]
  meetRequestsAssigned       MeetRequest[]              @relation("MeetAssignee")
  meetRequestsMade           MeetRequest[]              @relation("MeetRequester")
  notifications              Notification[]
  offboardingRecord          OffboardingProcess?        @relation("EmployeeOffboarding")
  ktAssignments              OffboardingProcess[]       @relation("KTAssignee")
  onboardingSession          OnboardingSession?
  payrollLineItems           PayrollLineItem[]
  payrollRunsInitiated       PayrollRun[]
  payrollSyncEvents          PayrollSyncEvent[]
  reviewsAsSubject           PerformanceReview[]        @relation("ReviewSubject")
  reviewsAuthored            PerformanceReview[]        @relation("ReviewAuthor")
  projectAssignments         ProjectAssignment[]
  recognitionsGiven          Recognition[]              @relation("RecognitionGiver")
  recognitionsReceived       Recognition[]              @relation("RecognitionReceiver")
  regularizationRequests     RegularizationRequest[]
  reimbursementsApproved     Reimbursement[]            @relation("ReimbursementApprover")
  reimbursementsClaimed      Reimbursement[]
  generatedReports           ReportHistory[]            @relation("ReportGenerator")
  requirementsAssigned       Requirement[]              @relation("RequirementOwner")
  salaryStructuresCreated    SalaryStructure[]          @relation("SalaryStructureCreator")
  salaryStructures           SalaryStructure[]
  successionPlansAsIncumbent SuccessionPlan[]           @relation("SuccessionIncumbent")
  successionPlansAsSuccessor SuccessionPlan[]           @relation("SuccessionSuccessor")
  surveyResponses            SurveyResponse[]
  surveysCreated             Survey[]
  talentApplications         TalentApplication[]
  taskActions                TaskAction[]
  taskComments               TaskComment[]
  assignedTasks              Task[]                     @relation("TaskAssignee")
  createdTasks               Task[]                     @relation("TaskCreator")
  reportedTasks              Task[]                     @relation("TaskReporter")
  transferRequestsMade       TransferRequest[]          @relation("TransferEmployee")
  transferRequestsProcessed  TransferRequest[]          @relation("TransferProcessor")
  user                       User?
  wfhRequestsApproved        WorkFromHomeRequest[]      @relation("WfhApprover")
  wfhRequestsMade            WorkFromHomeRequest[]      @relation("WfhRequester")
  workReportsSubmitted       WorkReport[]               @relation("ReportSubmitter")
  workReportsReviewed        WorkReport[]               @relation("ReportReviewer")
  workdaySummaries           WorkdaySummary[]
  workflowsInitiated         WorkflowInstance[]

  @@map("employees")
}

model CompliancePolicy {
  id          String   @id @default(cuid())
  title       String
  url         String
  updatedAt   DateTime @updatedAt
  updatedById String
  updatedBy   Employee @relation("PolicyUpdater", fields: [updatedById], references: [id])

  @@map("compliance_policies")
}

model StatutoryFiling {
  id       String    @id @default(cuid())
  title    String
  deadline DateTime  @db.Date
  status   String    @default("PENDING")
  filedAt  DateTime?

  @@map("statutory_filings")
}

model FieldWorkRequest {
  id              String          @id @default(cuid())
  employeeId      String
  approverId      String?
  date            DateTime        @db.Date
  startTime       String
  endTime         String
  destination     String
  client          String?
  purpose         String
  description     String
  transportation  String
  returnTime      String
  contact         String
  remarks         String?
  fileName        String?
  objectKey       String?
  status          FieldWorkStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  approvedAt      DateTime?
  approver        Employee?       @relation("FieldWorkApprover", fields: [approverId], references: [id])
  employee        Employee        @relation("FieldWorkRequester", fields: [employeeId], references: [id])

  @@index([employeeId, status])
  @@map("field_work_requests")
}

model User {
  id           String            @id @default(cuid())
  employeeId   String?           @unique
  email        String            @unique
  passwordHash String
  role         UserRole          @default(EMPLOYEE)
  status       UserStatus        @default(ACTIVE)
  totpSecret   String?
  lastLoginAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  devices      Device[]
  otps         OTPVerification[]
  sessions     Session[]
  employee     Employee?         @relation(fields: [employeeId], references: [id])

  @@map("users")
}

model Device {
  id          String    @id @default(cuid())
  userId      String
  fingerprint String
  name        String?
  isTrusted   Boolean   @default(false)
  trustedAt   DateTime?
  lastSeenAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions    Session[]

  @@unique([userId, fingerprint])
  @@map("devices")
}

model Department {
  id                 String            @id @default(cuid())
  code               String            @unique
  createdAt          DateTime          @default(now())
  headId             String?
  name               String            @unique
  parentDepartmentId String?
  updatedAt          DateTime          @updatedAt
  head               Employee?         @relation("DepartmentHead", fields: [headId], references: [id])
  parentDepartment   Department?       @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  childDepartments   Department[]      @relation("DepartmentHierarchy")
  designations       Designation[]
  employees          Employee[]        @relation("EmployeeDepartment")
  jobs               Job[]
  meetRequests       MeetRequest[]     @relation("DepartmentMeetRequests")
  transfersFrom      TransferRequest[] @relation("TransferFrom")
  transfersTo        TransferRequest[] @relation("TransferTo")

  @@map("departments")
}

model Designation {
  id                     String        @id @default(cuid())
  band                   String?
  createdAt              DateTime      @default(now())
  departmentId           String
  grade                  String?
  title                  String
  reportsToDesignationId String?
  department             Department    @relation(fields: [departmentId], references: [id])
  reportsToDesignation   Designation?  @relation("DesignationHierarchy", fields: [reportsToDesignationId], references: [id])
  childDesignations      Designation[] @relation("DesignationHierarchy")
  employees              Employee[]

  @@unique([title, departmentId])
  @@map("designations")
}

model Session {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  deviceId     String?
  expiresAt    DateTime
  ipAddress    String
  isActive     Boolean   @default(true)
  refreshToken String    @unique
  revokedAt    DateTime?
  userAgent    String
  userId       String
  device       Device?   @relation(fields: [deviceId], references: [id])
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model OTPVerification {
  id        String    @id @default(cuid())
  attempts  Int       @default(0)
  codeHash  String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  type      OtpType
  usedAt    DateTime?
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("otp_verifications")
}

model AttendanceRecord {
  id                    String           @id @default(cuid())
  checkInIp             String?
  checkInMethod         CheckInMethod?
  checkInTime           DateTime?
  checkOutTime          DateTime?
  createdAt             DateTime         @default(now())
  date                  DateTime         @db.Date
  employeeId            String
  isRegularized         Boolean          @default(false)
  notes                 String?
  overtime              Decimal?         @db.Decimal(5, 2)
  regularizedById       String?
  status                AttendanceStatus @default(PRESENT)
  totalBreakSeconds     Int              @default(0)
  currentBreakStartTime DateTime?
  breakHistory          Json?            @default("[]")
  punchHistory          Json?            @default("[]")
  updatedAt             DateTime         @updatedAt
  workHours             Decimal?         @db.Decimal(5, 2)
  isOvertimeApproved    Boolean          @default(false)
  overtimeApprovedById  String?
  employee              Employee         @relation(fields: [employeeId], references: [id])
  regularizedBy         Employee?        @relation("AttendanceRegularizer", fields: [regularizedById], references: [id])
  overtimeApprovedBy    Employee?        @relation("OvertimeApprover", fields: [overtimeApprovedById], references: [id])

  @@unique([employeeId, date])
  @@index([employeeId, date])
  @@map("attendance_records")
}

model WorkdaySummary {
  id              String   @id @default(cuid())
  employeeId      String
  date            DateTime @db.Date
  targetHours     Decimal  @db.Decimal(5, 2)
  actualWorkHours Decimal  @db.Decimal(5, 2)
  overtime        Decimal  @default(0) @db.Decimal(5, 2)
  shortfall       Decimal  @default(0) @db.Decimal(5, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  employee        Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([employeeId, date])
  @@map("workday_summaries")
}

model LeaveType {
  id                    String         @id @default(cuid())
  code                  String         @unique
  createdAt             DateTime       @default(now())
  isActive              Boolean        @default(true)
  isCarryForwardAllowed Boolean        @default(false)
  isPaidLeave           Boolean        @default(true)
  maxCarryForwardDays   Decimal?       @db.Decimal(4, 1)
  maxDaysPerYear        Decimal        @db.Decimal(4, 1)
  name                  String         @unique
  requiresDocumentAbove Decimal?       @db.Decimal(4, 1)
  balances              LeaveBalance[]
  requests              LeaveRequest[]

  @@map("leave_types")
}

model LeaveBalance {
  id               String    @id @default(cuid())
  allocated        Decimal   @db.Decimal(4, 1)
  carriedOver      Decimal   @default(0) @db.Decimal(4, 1)
  employeeId       String
  leaveTypeId      String
  pending          Decimal   @default(0) @db.Decimal(4, 1)
  updatedAt        DateTime  @updatedAt
  used             Decimal   @default(0) @db.Decimal(4, 1)
  year             Int
  lastAccruedMonth Int?
  employee         Employee  @relation(fields: [employeeId], references: [id])
  leaveType        LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id                 String             @id @default(cuid())
  appliedAt          DateTime           @default(now())
  approvedAt         DateTime?
  approverId         String?
  attachmentUrl      String?
  employeeId         String
  endDate            DateTime           @db.Date
  halfDaySession     String?
  isHalfDay          Boolean            @default(false)
  isEmergency        Boolean            @default(false)
  leaveTypeId        String
  reason             String
  rejectionReason    String?
  startDate          DateTime           @db.Date
  status             LeaveRequestStatus @default(PENDING)
  totalDays          Decimal            @db.Decimal(4, 1)
  paidDays           Decimal            @default(0) @db.Decimal(4, 1)
  unpaidDays         Decimal            @default(0) @db.Decimal(4, 1)
  workflowInstanceId String?
  approvalQueue      Json?
  currentStep        Int                @default(0)
  approver           Employee?          @relation("LeaveApprover", fields: [approverId], references: [id])
  employee           Employee           @relation("LeaveRequester", fields: [employeeId], references: [id])
  leaveType          LeaveType          @relation(fields: [leaveTypeId], references: [id])
  payrollSyncEvents  PayrollSyncEvent[]

  @@index([employeeId, status])
  @@map("leave_requests")
}

model Asset {
  id              String            @id @default(cuid())
  assetTag        String            @unique
  brand           String?
  category        AssetCategory
  createdAt       DateTime          @default(now())
  currentHolderId String?
  model           String?
  name            String
  notes           String?
  purchaseCost    Decimal?          @db.Decimal(10, 2)
  purchaseDate    DateTime?         @db.Date
  serialNumber    String?           @unique
  status          AssetStatus       @default(AVAILABLE)
  updatedAt       DateTime          @updatedAt
  assignments     AssetAssignment[]
  currentHolder   Employee?         @relation("CurrentAssetHolder", fields: [currentHolderId], references: [id])

  @@map("assets")
}

model AssetAssignment {
  id                String    @id @default(cuid())
  assetId           String
  assignedAt        DateTime  @default(now())
  assignedById      String
  employeeId        String
  notes             String?
  returnedAt        DateTime?
  returnedCondition String?
  asset             Asset     @relation(fields: [assetId], references: [id])
  assignedBy        Employee  @relation("AssetAssigner", fields: [assignedById], references: [id])
  employee          Employee  @relation("AssetAssignmentEmployee", fields: [employeeId], references: [id])

  @@map("asset_assignments")
}

model AssetRequest {
  id               String             @id @default(cuid())
  employeeId       String
  requesterId      String
  type             AssetRequestType
  status           AssetRequestStatus @default(PENDING_OM_SELECTION)
  requestedItems   Json               @default("[]")
  reason           String?
  selectedAssetIds String[]           @default([])
  omApproverId     String?
  ceoApproverId    String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  ceoApprover      Employee?          @relation("AssetRequestCEOApprover", fields: [ceoApproverId], references: [id])
  employee         Employee           @relation("AssetRequestEmployee", fields: [employeeId], references: [id])
  omApprover       Employee?          @relation("AssetRequestOMApprover", fields: [omApproverId], references: [id])
  requester        Employee           @relation("AssetRequestCreator", fields: [requesterId], references: [id])

  @@index([employeeId, status])
  @@map("asset_requests")
}

model Notification {
  id          String           @id @default(cuid())
  body        String
  createdAt   DateTime         @default(now())
  data        Json?
  isRead      Boolean          @default(false)
  readAt      DateTime?
  recipientId String
  title       String
  type        NotificationType
  recipient   Employee         @relation(fields: [recipientId], references: [id])

  @@index([recipientId, isRead])
  @@map("notifications")
}

model Workflow {
  id        String             @id @default(cuid())
  createdAt DateTime           @default(now())
  isActive  Boolean            @default(true)
  name      String
  steps     Json
  type      WorkflowType       @unique
  updatedAt DateTime           @updatedAt
  instances WorkflowInstance[]

  @@map("workflows")
}

model MeetRequest {
  id           String            @id @default(cuid())
  title        String
  description  String?
  startTime    DateTime
  endTime      DateTime
  status       MeetStatus        @default(PENDING)
  meetLink     String?
  eventId      String?
  type         MeetType          @default(ONE_ON_ONE)
  requesterId  String
  assigneeId   String?
  departmentId String?
  agenda       Json?
  actionItems  Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  linkedGoalId String?
  notes        MeetNote[]
  participants MeetParticipant[]
  assignee     Employee?         @relation("MeetAssignee", fields: [assigneeId], references: [id])
  department   Department?       @relation("DepartmentMeetRequests", fields: [departmentId], references: [id])
  linkedGoal   Goal?             @relation(fields: [linkedGoalId], references: [id])
  requester    Employee          @relation("MeetRequester", fields: [requesterId], references: [id])
  tasks        Task[]

  @@map("meet_requests")
}

model MeetParticipant {
  id            String      @id @default(cuid())
  meetRequestId String
  employeeId    String
  hasAccepted   Boolean     @default(false)
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  meetRequest   MeetRequest @relation(fields: [meetRequestId], references: [id], onDelete: Cascade)

  @@unique([meetRequestId, employeeId])
  @@map("meet_participants")
}

model WorkflowInstance {
  id               String                 @id @default(cuid())
  createdAt        DateTime               @default(now())
  currentStepIndex Int                    @default(0)
  initiatedById    String
  resourceId       String
  resourceType     String
  status           WorkflowInstanceStatus @default(PENDING)
  updatedAt        DateTime               @updatedAt
  workflowId       String
  metadata         Json?
  initiatedBy      Employee               @relation(fields: [initiatedById], references: [id])
  workflow         Workflow               @relation(fields: [workflowId], references: [id])

  @@index([resourceType, resourceId])
  @@map("workflow_instances")
}

model KnowledgeDoc {
  id                String                     @id @default(cuid())
  authorId          String
  category          KnowledgeCategory
  customCategory    String?
  content           String
  createdAt         DateTime                   @default(now())
  isPublished       Boolean                    @default(false)
  publishedAt       DateTime?
  searchVector      Unsupported("tsvector")?
  slug              String                     @unique
  title             String
  updatedAt         DateTime                   @updatedAt
  version           String                     @default("1.0")
  requiresSignature Boolean                    @default(false)
  acknowledgements  KnowledgeAcknowledgement[]
  versions          KnowledgeDocVersion[]
  author            Employee                   @relation(fields: [authorId], references: [id])

  @@map("knowledge_docs")
}

model KnowledgeDocVersion {
  id         String       @id @default(cuid())
  documentId String
  version    String
  title      String
  content    String
  authorId   String
  createdAt  DateTime     @default(now())
  author     Employee     @relation(fields: [authorId], references: [id])
  document   KnowledgeDoc @relation(fields: [documentId], references: [id])

  @@map("knowledge_doc_versions")
}

model KnowledgeAcknowledgement {
  id             String       @id @default(cuid())
  employeeId     String
  documentId     String
  signatureName  String
  acknowledgedAt DateTime     @default(now())
  document       KnowledgeDoc @relation(fields: [documentId], references: [id])
  employee       Employee     @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, documentId])
  @@map("knowledge_acknowledgements")
}

model AuditLog {
  id           String    @id @default(cuid())
  action       String
  actorId      String?
  deviceId     String?
  ipAddress    String?
  newValue     Json?
  oldValue     Json?
  performedAt  DateTime  @default(now())
  requestId    String
  resource     String
  resourceId   String
  userAgent    String?
  hash         String?   @unique
  previousHash String?
  actor        Employee? @relation(fields: [actorId], references: [id])

  @@index([resource, resourceId])
  @@index([actorId])
  @@index([performedAt])
  @@map("audit_logs")
}

// Master Admin Observatory: tracks every single page visit, click, and action
model ActivityLog {
  id         String   @id @default(cuid())
  employeeId String?
  userId     String?
  page       String
  action     String // PAGE_VIEW, CLICK, FORM_SUBMIT, DOWNLOAD, LOGOUT
  ipAddress  String?
  userAgent  String?
  deviceType String? // DESKTOP, MOBILE, TABLET
  browser    String?
  os         String?
  isp        String?
  city       String?
  country    String?
  durationMs Int? // Total dwell time on page in milliseconds (written on flush)
  sessionId  String?
  timestamp  DateTime @default(now())

  @@index([employeeId, timestamp])
  @@index([page, timestamp])
  @@index([timestamp])
  @@map("activity_logs")
}

// Master Admin Observatory: automated security alerts
model SecurityAlert {
  id          String    @id @default(cuid())
  employeeId  String?
  userId      String?
  type        String // IP_MISMATCH, NEW_DEVICE, CONCURRENT_SESSION, RAPID_LOCATION_CHANGE
  severity    String // LOW, MEDIUM, HIGH, CRITICAL
  loginIp     String?
  checkinIp   String?
  loginCity   String?
  checkinCity String?
  details     Json?
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime  @default(now())

  @@index([employeeId, createdAt])
  @@index([type, createdAt])
  @@map("security_alerts")
}

model ConsentLog {
  id            String    @id @default(cuid())
  collectedById String
  consentedAt   DateTime  @default(now())
  employeeId    String
  ipAddress     String
  notes         String?
  purpose       String
  revokedAt     DateTime?
  collectedBy   Employee  @relation("ConsentCollector", fields: [collectedById], references: [id])
  employee      Employee  @relation("ConsentSubject", fields: [employeeId], references: [id])

  @@map("consent_logs")
}

model DataErasureRequest {
  id            String               @id @default(cuid())
  approvedAt    DateTime?
  approvedById  String?
  employeeId    String
  fieldsErased  Json?
  notes         String?
  processedAt   DateTime?
  requestedAt   DateTime             @default(now())
  requestedById String
  status        ErasureRequestStatus @default(PENDING)
  approvedBy    Employee?            @relation("ErasureApprover", fields: [approvedById], references: [id])
  employee      Employee             @relation("ErasureSubject", fields: [employeeId], references: [id])
  requestedBy   Employee             @relation("ErasureRequester", fields: [requestedById], references: [id])

  @@map("data_erasure_requests")
}

model OffboardingProcess {
  id                    String    @id @default(cuid())
  employeeId            String    @unique
  resignationDate       DateTime
  lastWorkingDay        DateTime
  exitType              String
  exitReason            String?
  accessRevocationDate  DateTime?
  ktAssigneeId          String?
  ktTargetDate          DateTime?
  ffExpectedDate        DateTime?
  generateLetters       Boolean   @default(true)
  exitInterviewDate     DateTime?
  status                String    @default("IN_PROGRESS")
  assetChecklist        Json      @default("[]")
  deactivationChecklist Json      @default("[]")
