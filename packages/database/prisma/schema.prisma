  notes          Json?         @default("[]")
  calls          Json?         @default("[]")
  assignedCem    Employee?     @relation("ClientLeadOwner", fields: [assignedCemId], references: [id])
  assignedCrm    Employee?     @relation("ClientCrmOwner", fields: [assignedCrmId], references: [id])
  meetings       Meeting[]     @relation("ClientLeadMeetings")
  requirements   Requirement[]

  @@map("client_leads")
}

model IncomingHandoff {
  id           String @id @default(cuid())
  company      String
  industry     String
  assignedBy   String
  assignedDate String
  phone        String
  email        String
  priority     String

  @@map("incoming_handoffs")
}

model Requirement {
  id                  String              @id @default(cuid())
  title               String
  clientName          String
  module              String
  priority            String
  status              String
  category            String
  businessNeed        String
  description         String
  expectedDelivery    String
  clientNotes         String
  internalNotes       String
  owner               String
  createdBy           String
  requestedBy         String
  decisionMaker       String
  approver            String
  dependencies        Json?
  attachments         String[]
  timeline            Json?
  clientLeadId        String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  assignedCrmId       String?
  requirementDecision RequirementDecision @default(PENDING)
  assignedCrm         Employee?           @relation("RequirementOwner", fields: [assignedCrmId], references: [id])
  clientLead          ClientLead?         @relation(fields: [clientLeadId], references: [id])

  @@map("requirements")
}

model CrmActivityLog {
  id          String   @id @default(cuid())
  clientId    String?
  clientName  String?
  action      String
  description String
  createdAt   DateTime @default(now())

  @@map("crm_activity_logs")
}

model Meeting {
  id               String      @id @default(cuid())
  client           String
  leadId           String
  leadName         String
  date             String
  time             String
  type             String
  assignedEmployee String
  status           String      @default("SCHEDULED")
  outcome          String?     @default("None")
  nextAction       String?     @default("None")
  nextFollowUpDate String?
  nextActionOwner  String?
  notes            String?
  requirements     String?
  concerns         String?
  decisionMakers   String?
  handoffCompleted Boolean     @default(false)
  clientPhone      String?
  interactionCount Int?        @default(1)
  cemLeadId        String?
  clientLeadId     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  cemLead          CemLead?    @relation(fields: [cemLeadId], references: [id], onDelete: Cascade)
  clientLead       ClientLead? @relation("ClientLeadMeetings", fields: [clientLeadId], references: [id])

  @@map("meetings")
}

model FollowUp {
  id           String   @id @default(uuid())
  leadName     String
  role         String?
  company      String
  email        String
  phone        String
  currentStage String   @default("Contacted")
  type         String
  nextAction   String
  dueDate      DateTime
  priority     String   @default("Medium")
  lastNote     String?
  status       String   @default("Pending")
  outcome      String?  @default("None")
  assignedCem  String
  notesHistory String[]
  cemLeadId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  cemLead      CemLead? @relation(fields: [cemLeadId], references: [id], onDelete: Cascade)

  @@map("follow_ups")
}

model CemLead {
  id                  String     @id @default(cuid())
  company             String
  prospectName        String
  industry            String
  phone               String
  email               String
  priority            String     @default("MEDIUM")
  stage               Int        @default(1)
  assignedCemId       String
  leadSource          String
  qualificationScore  Int        @default(0)
  budgetConfirmed     Boolean    @default(false)
  authorityIdentified Boolean    @default(false)
  needValidated       Boolean    @default(false)
  timelineEstablished Boolean    @default(false)
  qualificationStatus String     @default("ACTIVE")
  assignedCrm         String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  assignedCem         Employee   @relation("CemLeadOwner", fields: [assignedCemId], references: [id])
  followUps           FollowUp[]
  meetings            Meeting[]

  @@map("cem_leads")
}

model WorkReport {
  id              String         @id @default(cuid())
  employeeId      String
  reviewerId      String?
  department      String
  reportType      String
  title           String
  content         Json?
  attachments     Json?          @default("[]")
  priority        ReportPriority @default(MEDIUM)
  status          ReportStatus   @default(PENDING)
  submittedAt     DateTime       @default(now())
  reviewedAt      DateTime?
  rejectionReason String?
  employee        Employee       @relation("ReportSubmitter", fields: [employeeId], references: [id])
  reviewer        Employee?      @relation("ReportReviewer", fields: [reviewerId], references: [id])

  @@index([reviewerId, status])
  @@map("work_reports")
}

model SystemJobLog {
  id         String   @id @default(cuid())
  jobName    String   @unique
  executedAt DateTime @default(now())

  @@map("system_job_logs")
}

model DailyWorkLog {
  id         String   @id @default(cuid())
  employeeId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  date       String
  content    String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@map("daily_work_logs")
}

