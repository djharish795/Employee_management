}

model User {
  id           String            @id @default(cuid())
  employeeId   String?           @unique
  email        String            @unique
  passwordHash String
  role         UserRole          @default(EMPLOYEE)
  status       UserStatus        @default(ACTIVE)
  totpSecret   String?
  lastLoginAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  devices      Device[]
  otps         OTPVerification[]
  sessions     Session[]
  employee     Employee?         @relation(fields: [employeeId], references: [id])

  @@map("users")
}

model Device {
  id          String    @id @default(cuid())
  userId      String
  fingerprint String
  name        String?
  isTrusted   Boolean   @default(false)
  trustedAt   DateTime?
  lastSeenAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions    Session[]

  @@unique([userId, fingerprint])
  @@map("devices")
}

model Department {
  id                 String            @id @default(cuid())
  code               String            @unique
  createdAt          DateTime          @default(now())
  headId             String?
  name               String            @unique
  parentDepartmentId String?
  updatedAt          DateTime          @updatedAt
  head               Employee?         @relation("DepartmentHead", fields: [headId], references: [id])
  parentDepartment   Department?       @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  childDepartments   Department[]      @relation("DepartmentHierarchy")
  designations       Designation[]
  employees          Employee[]        @relation("EmployeeDepartment")
  jobs               Job[]
  transfersFrom      TransferRequest[] @relation("TransferFrom")
  transfersTo        TransferRequest[] @relation("TransferTo")
  meetRequests       MeetRequest[]     @relation("DepartmentMeetRequests")

  @@map("departments")
}

model Designation {
  id                     String        @id @default(cuid())
  band                   String?
  createdAt              DateTime      @default(now())
  departmentId           String
  grade                  String?
  title                  String
  reportsToDesignationId String?
  reportsToDesignation   Designation?  @relation("DesignationHierarchy", fields: [reportsToDesignationId], references: [id])
  childDesignations      Designation[] @relation("DesignationHierarchy")
  department             Department    @relation(fields: [departmentId], references: [id])
  employees              Employee[]

  @@unique([title, departmentId])
  @@map("designations")
}

model Session {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  deviceId     String?
  expiresAt    DateTime
  ipAddress    String
  isActive     Boolean   @default(true)
  refreshToken String    @unique
  revokedAt    DateTime?
  userAgent    String
  userId       String
  device       Device?   @relation(fields: [deviceId], references: [id])
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model OTPVerification {
  id        String    @id @default(cuid())
  attempts  Int       @default(0)
  codeHash  String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  type      OtpType
  usedAt    DateTime?
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("otp_verifications")
}

model AttendanceRecord {
  id                    String           @id @default(cuid())
  checkInIp             String?
  checkInMethod         CheckInMethod?
  checkInTime           DateTime?
  checkOutTime          DateTime?
  createdAt             DateTime         @default(now())
  date                  DateTime         @db.Date
  employeeId            String
  isRegularized         Boolean          @default(false)
  notes                 String?
  overtime              Decimal?         @db.Decimal(5, 2)
  regularizedById       String?
  status                AttendanceStatus @default(PRESENT)
  totalBreakSeconds     Int              @default(0)
  currentBreakStartTime DateTime?
  breakHistory          Json?            @default("[]")
  updatedAt             DateTime         @updatedAt
  workHours             Decimal?         @db.Decimal(5, 2)
  employee              Employee         @relation(fields: [employeeId], references: [id])
  regularizedBy         Employee?        @relation("AttendanceRegularizer", fields: [regularizedById], references: [id])

  @@unique([employeeId, date])
  @@index([employeeId, date])
  @@map("attendance_records")
}

model LeaveType {
  id                    String         @id @default(cuid())
  code                  String         @unique
  createdAt             DateTime       @default(now())
  isActive              Boolean        @default(true)
  isCarryForwardAllowed Boolean        @default(false)
  isPaidLeave           Boolean        @default(true)
  maxCarryForwardDays   Decimal?       @db.Decimal(4, 1)
  maxDaysPerYear        Decimal        @db.Decimal(4, 1)
  name                  String         @unique
  requiresDocumentAbove Decimal?       @db.Decimal(4, 1)
  balances              LeaveBalance[]
  requests              LeaveRequest[]

  @@map("leave_types")
}

model LeaveBalance {
  id          String    @id @default(cuid())
  allocated   Decimal   @db.Decimal(4, 1)
  carriedOver Decimal   @default(0) @db.Decimal(4, 1)
  employeeId  String
  leaveTypeId String
  pending     Decimal   @default(0) @db.Decimal(4, 1)
  updatedAt   DateTime  @updatedAt
  used        Decimal   @default(0) @db.Decimal(4, 1)
  year        Int
  employee    Employee  @relation(fields: [employeeId], references: [id])
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id                 String             @id @default(cuid())
  appliedAt          DateTime           @default(now())
  approvedAt         DateTime?
  approverId         String?
  attachmentUrl      String?
  employeeId         String
  endDate            DateTime           @db.Date
  halfDaySession     String?
  isHalfDay          Boolean            @default(false)
  isEmergency        Boolean            @default(false)
  leaveTypeId        String
  reason             String
  rejectionReason    String?
  startDate          DateTime           @db.Date
  status             LeaveRequestStatus @default(PENDING)
  totalDays          Decimal            @db.Decimal(4, 1)
  workflowInstanceId String?
  approvalQueue      Json?
  currentStep        Int                @default(0)
  approver           Employee?          @relation("LeaveApprover", fields: [approverId], references: [id])
  employee           Employee           @relation("LeaveRequester", fields: [employeeId], references: [id])
  leaveType          LeaveType          @relation(fields: [leaveTypeId], references: [id])

  @@index([employeeId, status])
  @@map("leave_requests")
}

model Asset {
  id              String            @id @default(cuid())
  assetTag        String            @unique
  brand           String?
  category        AssetCategory
  createdAt       DateTime          @default(now())
  currentHolderId String?
  model           String?
  name            String
  notes           String?
  purchaseCost    Decimal?          @db.Decimal(10, 2)
  purchaseDate    DateTime?         @db.Date
  serialNumber    String?           @unique
  status          AssetStatus       @default(AVAILABLE)
  updatedAt       DateTime          @updatedAt
  assignments     AssetAssignment[]
  currentHolder   Employee?         @relation("CurrentAssetHolder", fields: [currentHolderId], references: [id])

  @@map("assets")
}

model AssetAssignment {
  id                String    @id @default(cuid())
  assetId           String
  assignedAt        DateTime  @default(now())
  assignedById      String
  employeeId        String
  notes             String?
  returnedAt        DateTime?
  returnedCondition String?
  asset             Asset     @relation(fields: [assetId], references: [id])
  assignedBy        Employee  @relation("AssetAssigner", fields: [assignedById], references: [id])
  employee          Employee  @relation("AssetAssignmentEmployee", fields: [employeeId], references: [id])

  @@map("asset_assignments")
}

model Notification {
  id          String           @id @default(cuid())
  body        String
  createdAt   DateTime         @default(now())
  data        Json?
  isRead      Boolean          @default(false)
  readAt      DateTime?
  recipientId String
  title       String
  type        NotificationType
  recipient   Employee         @relation(fields: [recipientId], references: [id])

  @@index([recipientId, isRead])
  @@map("notifications")
}

model Workflow {
  id        String             @id @default(cuid())
  createdAt DateTime           @default(now())
  isActive  Boolean            @default(true)
  name      String
  steps     Json
  type      WorkflowType       @unique
  updatedAt DateTime           @updatedAt
  instances WorkflowInstance[]

  @@map("workflows")
}

enum MeetStatus {
  PENDING
  ACCEPTED
  REJECTED
  RESCHEDULED
  CANCELLED
}

enum MeetType {
  ONE_ON_ONE
  DEPARTMENT
}

model MeetRequest {
  id           String     @id @default(cuid())
  title        String
  description  String?
  startTime    DateTime
  endTime      DateTime
  status       MeetStatus @default(PENDING)
  meetLink     String?
  eventId      String?
  type         MeetType   @default(ONE_ON_ONE)
  requesterId  String
  assigneeId   String?
  departmentId String?
  agenda       Json?
  actionItems  Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  linkedGoalId String?

  requester    Employee          @relation("MeetRequester", fields: [requesterId], references: [id])
  assignee     Employee?         @relation("MeetAssignee", fields: [assigneeId], references: [id])
  department   Department?       @relation("DepartmentMeetRequests", fields: [departmentId], references: [id])
  linkedGoal   Goal?             @relation(fields: [linkedGoalId], references: [id], onDelete: SetNull)
  participants MeetParticipant[]
  tasks        Task[]

  @@map("meet_requests")
}

model MeetParticipant {
  id            String  @id @default(cuid())
  meetRequestId String
  employeeId    String
  hasAccepted   Boolean @default(false)

  meetRequest MeetRequest @relation(fields: [meetRequestId], references: [id], onDelete: Cascade)
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([meetRequestId, employeeId])
  @@map("meet_participants")
}

model WorkflowInstance {
  id               String                 @id @default(cuid())
  createdAt        DateTime               @default(now())
  currentStepIndex Int                    @default(0)
  initiatedById    String
  resourceId       String
  resourceType     String
  status           WorkflowInstanceStatus @default(PENDING)
  updatedAt        DateTime               @updatedAt
  workflowId       String
  metadata         Json?
  initiatedBy      Employee               @relation(fields: [initiatedById], references: [id])
  workflow         Workflow               @relation(fields: [workflowId], references: [id])

  @@index([resourceType, resourceId])
  @@map("workflow_instances")
}

model KnowledgeDoc {
  id                String                     @id @default(cuid())
  authorId          String
  category          KnowledgeCategory
  content           String
  createdAt         DateTime                   @default(now())
  isPublished       Boolean                    @default(false)
  publishedAt       DateTime?
  searchVector      Unsupported("tsvector")?
  slug              String                     @unique
  title             String
  updatedAt         DateTime                   @updatedAt
  version           String                     @default("1.0")
  requiresSignature Boolean                    @default(false)
  author            Employee                   @relation(fields: [authorId], references: [id])
  acknowledgements  KnowledgeAcknowledgement[]

  @@map("knowledge_docs")
}

model KnowledgeAcknowledgement {
  id             String   @id @default(cuid())
  employeeId     String
  documentId     String
  signatureName  String // The full name typed by the employee as signature
  acknowledgedAt DateTime @default(now())

  employee Employee     @relation(fields: [employeeId], references: [id])
  document KnowledgeDoc @relation(fields: [documentId], references: [id])

  @@unique([employeeId, documentId])
  @@map("knowledge_acknowledgements")
}

model AuditLog {
  id          String    @id @default(cuid())
  action      String
  actorId     String?
  deviceId    String?
  ipAddress   String?
  newValue    Json?
  oldValue    Json?
  performedAt DateTime  @default(now())
  requestId   String
  resource    String
  resourceId  String
  userAgent   String?
  actor       Employee? @relation(fields: [actorId], references: [id])

  @@index([resource, resourceId])
  @@index([actorId])
  @@index([performedAt])
  @@map("audit_logs")
}

model ConsentLog {
  id            String    @id @default(cuid())
  collectedById String
  consentedAt   DateTime  @default(now())
  employeeId    String
  ipAddress     String
  notes         String?
  purpose       String
  revokedAt     DateTime?
  collectedBy   Employee  @relation("ConsentCollector", fields: [collectedById], references: [id])
  employee      Employee  @relation("ConsentSubject", fields: [employeeId], references: [id])

  @@map("consent_logs")
}

model DataErasureRequest {
  id            String               @id @default(cuid())
  approvedAt    DateTime?
  approvedById  String?
  employeeId    String
  fieldsErased  Json?
  notes         String?
  processedAt   DateTime?
  requestedAt   DateTime             @default(now())
  requestedById String
  status        ErasureRequestStatus @default(PENDING)
  approvedBy    Employee?            @relation("ErasureApprover", fields: [approvedById], references: [id])
  employee      Employee             @relation("ErasureSubject", fields: [employeeId], references: [id])
  requestedBy   Employee             @relation("ErasureRequester", fields: [requestedById], references: [id])

  @@map("data_erasure_requests")
}

model OffboardingProcess {
  id                   String    @id @default(cuid())
  employeeId           String    @unique
  resignationDate      DateTime
  lastWorkingDay       DateTime
  exitType             String
  exitReason           String?
  accessRevocationDate DateTime?
  ktAssigneeId         String?
  ktTargetDate         DateTime?
  ffExpectedDate       DateTime?
  generateLetters      Boolean   @default(true)
  exitInterviewDate    DateTime?
  status               String    @default("IN_PROGRESS")

  assetChecklist        Json @default("[]")
  deactivationChecklist Json @default("[]")
  settlementChecklist   Json @default("[]")
  ktChecklist           Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee   Employee  @relation("EmployeeOffboarding", fields: [employeeId], references: [id], onDelete: Cascade)
  ktAssignee Employee? @relation("KTAssignee", fields: [ktAssigneeId], references: [id], onDelete: SetNull)

  @@map("offboarding_processes")
}

model GrievanceCase {
  id          String          @id @default(cuid())
  description String
  employeeId  String
  officerId   String?
  openedAt    DateTime        @default(now())
  resolution  String?
  resolvedAt  DateTime?
  status      GrievanceStatus @default(OPEN)
  employee    Employee        @relation("GrievanceSubject", fields: [employeeId], references: [id])
  officer     Employee?       @relation("GrievanceOfficer", fields: [officerId], references: [id])

  @@map("grievance_cases")
}

model AppSetting {
  id          String    @id @default(cuid())
  category    String
  key         String    @unique
  updatedAt   DateTime  @updatedAt
  updatedById String?
  value       Json
  updatedBy   Employee? @relation(fields: [updatedById], references: [id])

  @@map("app_settings")
}

model SalaryStructure {
  id               String   @id @default(cuid())
  basicSalary      Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  createdById      String
  ctc              Decimal  @db.Decimal(12, 2)
  effectiveFrom    DateTime @db.Date
  employeeId       String
  esiEligible      Boolean  @default(false)
  hra              Decimal  @db.Decimal(12, 2)
  pfEligible       Boolean  @default(true)
  specialAllowance Decimal  @db.Decimal(12, 2)
  createdBy        Employee @relation("SalaryStructureCreator", fields: [createdById], references: [id])
  employee         Employee @relation(fields: [employeeId], references: [id])

  @@map("salary_structures")
}

model PayrollRun {
  id             String            @id @default(cuid())
  bankFileName   String?
  completedAt    DateTime?
  failedAt       DateTime?
  failureReason  String?
  initiatedById  String
  month          Int
  processedCount Int               @default(0)
  startedAt      DateTime?
  status         PayrollRunStatus  @default(PENDING)
  totalAmount    Decimal?          @db.Decimal(14, 2)
  year           Int
  lineItems      PayrollLineItem[]
  initiatedBy    Employee          @relation(fields: [initiatedById], references: [id])
  reimbursements Reimbursement[]

  @@unique([month, year])
  @@map("payroll_runs")
}

model PayrollLineItem {
  id               String                @id @default(cuid())
  bankAccountEnc   String
  basicSalary      Decimal               @db.Decimal(12, 2)
  employeeId       String
  esi              Decimal               @db.Decimal(10, 2)
  grossSalary      Decimal               @db.Decimal(12, 2)
  hra              Decimal               @db.Decimal(12, 2)
  ifscCode         String
  netSalary        Decimal               @db.Decimal(12, 2)
  payrollRunId     String
  payslipUrl       String?
  pfEmployee       Decimal               @db.Decimal(10, 2)
  pfEmployer       Decimal               @db.Decimal(10, 2)
  professionalTax  Decimal               @db.Decimal(10, 2)
  specialAllowance Decimal               @db.Decimal(12, 2)
  status           PayrollLineItemStatus @default(PENDING)
  tds              Decimal               @db.Decimal(10, 2)
  totalDeductions  Decimal               @db.Decimal(10, 2)
  employee         Employee              @relation(fields: [employeeId], references: [id])
  payrollRun       PayrollRun            @relation(fields: [payrollRunId], references: [id])

  @@unique([payrollRunId, employeeId])
  @@map("payroll_line_items")
}

model Reimbursement {
  id           String              @id @default(cuid())
  amount       Decimal             @db.Decimal(10, 2)
  approverId   String?
  category     String
  createdAt    DateTime            @default(now())
  description  String
  employeeId   String
  payrollRunId String?
  receiptUrl   String?
  status       ReimbursementStatus @default(PENDING)
  approver     Employee?           @relation("ReimbursementApprover", fields: [approverId], references: [id])
  employee     Employee            @relation(fields: [employeeId], references: [id])
  payrollRun   PayrollRun?         @relation(fields: [payrollRunId], references: [id])

  @@map("reimbursements")
}

model Job {
  id                 String              @id @default(cuid())
  createdAt          DateTime            @default(now())
  ctcMax             Decimal?            @db.Decimal(12, 2)
  ctcMin             Decimal?            @db.Decimal(12, 2)
  departmentId       String
  filledPositions    Int                 @default(0)
  hiringManagerId    String
  jobDescription     String
  maxExperience      Int
  minExperience      Int
  openPositions      Int                 @default(1)
  requiredSkills     String[]
  status             JobStatus           @default(DRAFT)
  targetDate         DateTime?           @db.Date
  title              String
  candidates         Candidate[]
  department         Department          @relation(fields: [departmentId], references: [id])
  hiringManager      Employee            @relation(fields: [hiringManagerId], references: [id])
  talentApplications TalentApplication[]

  @@map("jobs")
}

model Candidate {
  id            String         @id @default(cuid())
  appliedAt     DateTime       @default(now())
  currentCTC    Decimal?       @db.Decimal(12, 2)
  currentStage  CandidateStage @default(APPLIED)
  email         String
  expectedCTC   Decimal?       @db.Decimal(12, 2)
  jobId         String
  name          String
  noticePeriod  Int?
  phone         String
  resumeUrl     String?
  skills        String[]
  sourceChannel String?
  updatedAt     DateTime       @updatedAt
  job           Job            @relation(fields: [jobId], references: [id])
  interviews    Interview[]
  offer         Offer?

  @@map("candidates")
}

model Interview {
  id             String                   @id @default(cuid())
  candidateId    String
  completedAt    DateTime?
  feedback       String?
  interviewerId  String
  rating         Int?
  recommendation InterviewRecommendation?
  scheduledAt    DateTime
  status         InterviewStatus          @default(SCHEDULED)
  type           InterviewType
  candidate      Candidate                @relation(fields: [candidateId], references: [id])
  interviewer    Employee                 @relation(fields: [interviewerId], references: [id])

  @@map("interviews")
}

model Offer {
  id             String      @id @default(cuid())
  candidateId    String      @unique
  expiresAt      DateTime?
  joiningDate    DateTime?   @db.Date
  offerLetterUrl String?
  offeredCTC     Decimal     @db.Decimal(12, 2)
  respondedAt    DateTime?
  sentAt         DateTime?
  status         OfferStatus @default(DRAFT)
  candidate      Candidate   @relation(fields: [candidateId], references: [id])

  @@map("offers")
}

model Goal {
  id            String        @id @default(cuid())
  createdAt     DateTime      @default(now())
  currentValue  Decimal?      @db.Decimal(10, 2)
  description   String?
  dueDate       DateTime?     @db.Date
  employeeId    String
  reviewCycleId String?
  status        GoalStatus    @default(NOT_STARTED)
  targetValue   Decimal?      @db.Decimal(10, 2)
  title         String
  type          GoalType
  unit          String?
  weight        Decimal?      @db.Decimal(5, 2)
  employee      Employee      @relation(fields: [employeeId], references: [id])
  reviewCycle   ReviewCycle?  @relation(fields: [reviewCycleId], references: [id])
  meetRequests  MeetRequest[]

  @@map("goals")
}

model ReviewCycle {
  id        String              @id @default(cuid())
  createdAt DateTime            @default(now())
  endDate   DateTime            @db.Date
  name      String
  quarter   Int?
  startDate DateTime            @db.Date
  status    ReviewCycleStatus   @default(UPCOMING)
  type      ReviewCycleType
  year      Int
  goals     Goal[]
  reviews   PerformanceReview[]

  @@map("review_cycles")
}

model PerformanceReview {
  id             String       @id @default(cuid())
  acknowledgedAt DateTime?
  employeeId     String
  feedback       String?
  overallRating  Decimal?     @db.Decimal(3, 1)
  reviewCycleId  String
  reviewerId     String
  status         ReviewStatus @default(PENDING)
  submittedAt    DateTime?
  type           ReviewType
  employee       Employee     @relation("ReviewSubject", fields: [employeeId], references: [id])
  reviewCycle    ReviewCycle  @relation(fields: [reviewCycleId], references: [id])
  reviewer       Employee     @relation("ReviewAuthor", fields: [reviewerId], references: [id])

  @@map("performance_reviews")
}

model Skill {
  id             String          @id @default(cuid())
  category       SkillCategory
  createdAt      DateTime        @default(now())
  name           String          @unique
  subcategory    String?
  employeeSkills EmployeeSkill[]

  @@map("skills")
}

model EmployeeSkill {
  id                String           @id @default(cuid())
  employeeId        String
  isVerified        Boolean          @default(false)
  proficiencyLevel  ProficiencyLevel
  skillId           String
  updatedAt         DateTime         @updatedAt
  verifiedById      String?
  yearsOfExperience Decimal?         @db.Decimal(4, 1)
  employee          Employee         @relation(fields: [employeeId], references: [id])
  skill             Skill            @relation(fields: [skillId], references: [id])
  verifiedBy        Employee?        @relation("SkillVerifier", fields: [verifiedById], references: [id])

  @@unique([employeeId, skillId])
  @@map("employee_skills")
}

model Course {
  id            String       @id @default(cuid())
  category      String
  courseUrl     String?
  createdAt     DateTime     @default(now())
  description   String?
  durationHours Decimal      @db.Decimal(5, 1)
  isActive      Boolean      @default(true)
  isInternal    Boolean      @default(false)
  provider      String
  title         String
  enrollments   Enrollment[]

  @@map("courses")
}

model Enrollment {
  id              String           @id @default(cuid())
  certificateUrl  String?
  completedAt     DateTime?
  courseId        String
  employeeId      String
  enrolledAt      DateTime         @default(now())
  progressPercent Decimal          @default(0) @db.Decimal(5, 2)
  status          EnrollmentStatus @default(ENROLLED)
  course          Course           @relation(fields: [courseId], references: [id])
  employee        Employee         @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, courseId])
  @@map("enrollments")
}

model Survey {
  id             String           @id @default(cuid())
  createdById    String
  endDate        DateTime         @db.Date
  isAnonymous    Boolean          @default(true)
  questions      Json
  startDate      DateTime         @db.Date
  status         SurveyStatus     @default(DRAFT)
  targetAudience SurveyAudience   @default(ALL)
  title          String
  type           SurveyType
  responses      SurveyResponse[]
  createdBy      Employee         @relation(fields: [createdById], references: [id])

  @@map("surveys")
}

model SurveyResponse {
  id           String    @id @default(cuid())
  answers      Json
  respondentId String?
  submittedAt  DateTime  @default(now())
  surveyId     String
  respondent   Employee? @relation(fields: [respondentId], references: [id])
  survey       Survey    @relation(fields: [surveyId], references: [id])

  @@map("survey_responses")
}

model Recognition {
  id             String          @id @default(cuid())
