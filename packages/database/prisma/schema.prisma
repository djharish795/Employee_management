// Naprocs EMS — Prisma Schema
// P1 migrations: 0001_p1_* | P2: 0020_p2_* | P3: 0040_p3_*

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// P1 AUTH & RBAC
// ─────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  CEO
  CTO
  COO
  CFO
  CHRO
  HR
  FINANCE
  MANAGER
  TEAM_LEAD
  EMPLOYEE
  IT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum EmployeeStatus {
  PROBATION
  ACTIVE
  NOTICE_PERIOD
  EXITED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum EmployeeType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

model Employee {
  id                  String         @id @default(cuid())
  employeeId          String         @unique
  firstName           String
  lastName            String
  middleName          String?
  preferredName       String?
  officialEmail       String         @unique
  personalEmail       String?
  phone               String?
  alternatePhone      String?
  photoUrl            String?
  dateOfBirth         DateTime?
  gender              Gender?
  bloodGroup          String?
  nationality         String?        @default("Indian")
  maritalStatus       MaritalStatus?
  currentAddress      Json?
  permanentAddress    Json?
  emergencyContact    Json?
  aadhaar             String?
  pan                 String?
  passport            String?
  drivingLicence      String?
  voterId             String?
  departmentId        String?
  department          Department?    @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  designationId       String?
  designation         Designation?   @relation(fields: [designationId], references: [id])
  status              EmployeeStatus @default(PROBATION)
  joiningDate         DateTime?
  employeeType        EmployeeType?  @default(FULL_TIME)
  grade               String?
  band                String?
  workLocation        String?
  reportingManagerId  String?
  reportingManager    Employee?      @relation("ReportingManager", fields: [reportingManagerId], references: [id])
  subordinates        Employee[]     @relation("ReportingManager")
  skipLevelManagerId  String?
  skipLevelManager    Employee?      @relation("SkipLevelManager", fields: [skipLevelManagerId], references: [id])
  skipLevelOf         Employee[]     @relation("SkipLevelManager")
  exitDate            DateTime?
  exitReason          String?
  backgroundVerified  Boolean        @default(false)
  digitalSignatureUrl String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  user                User?
  headOf              Department[]   @relation("DepartmentHead")
  attendanceRecords        AttendanceRecord[] @relation
  regularizedAttendances   AttendanceRecord[] @relation("AttendanceRegularizer")
  leaveBalances       LeaveBalance[]
  leaveRequestsMade   LeaveRequest[]   @relation("LeaveRequester")
  leaveRequestsToApprove LeaveRequest[] @relation("LeaveApprover")
  assetsHeld          Asset[]           @relation("CurrentAssetHolder")
  assetAssignments    AssetAssignment[] @relation("AssetAssignmentEmployee")
  assetsAssignedByMe  AssetAssignment[] @relation("AssetAssigner")
  notifications       Notification[]
  workflowsInitiated WorkflowInstance[]
  knowledgeDocsAuthored KnowledgeDoc[]
  auditLogEntries     AuditLog[]
  consentLogsAsSubject     ConsentLog[]           @relation("ConsentSubject")
  consentLogsCollected     ConsentLog[]           @relation("ConsentCollector")
  erasureRequestsAsSubject DataErasureRequest[]   @relation("ErasureSubject")
  erasureRequestsMade      DataErasureRequest[]   @relation("ErasureRequester")
  erasureRequestsApproved  DataErasureRequest[]   @relation("ErasureApprover")
  grievanceCasesAsSubject  GrievanceCase[]        @relation("GrievanceSubject")
  grievanceCasesAsOfficer  GrievanceCase[]        @relation("GrievanceOfficer")
  appSettingsUpdated AppSetting[]
  salaryStructures        SalaryStructure[]
  salaryStructuresCreated SalaryStructure[] @relation("SalaryStructureCreator")
  payrollRunsInitiated    PayrollRun[]
  payrollLineItems        PayrollLineItem[]
  reimbursementsClaimed  Reimbursement[]
  reimbursementsApproved Reimbursement[] @relation("ReimbursementApprover")
  jobsAsHiringManager  Job[]
  interviewsConducted  Interview[]
  goals                   Goal[]
  reviewsAsSubject        PerformanceReview[] @relation("ReviewSubject")
  reviewsAuthored         PerformanceReview[] @relation("ReviewAuthor")
  employeeSkills       EmployeeSkill[] @relation
  skillsVerified       EmployeeSkill[] @relation("SkillVerifier")
  enrollments Enrollment[]
  surveysCreated         Survey[]
  surveyResponses        SurveyResponse[]
  recognitionsGiven      Recognition[]    @relation("RecognitionGiver")
  recognitionsReceived   Recognition[]    @relation("RecognitionReceiver")
  successionPlansAsIncumbent  SuccessionPlan[]      @relation("SuccessionIncumbent")
  successionPlansAsSuccessor  SuccessionPlan[]      @relation("SuccessionSuccessor")
  talentApplications          TalentApplication[]
  transferRequestsMade        TransferRequest[]     @relation("TransferEmployee")
  transferRequestsProcessed   TransferRequest[]     @relation("TransferProcessor")
  attritionRiskScores AttritionRiskScore[]
  aiChats AIChat[]

  @@map("employees")
}

model User {
  id           String     @id @default(cuid())
  employeeId   String?    @unique
  employee     Employee?  @relation(fields: [employeeId], references: [id])
  email        String     @unique
  passwordHash String
  role         UserRole   @default(EMPLOYEE)
  status       UserStatus @default(ACTIVE)
  totpSecret   String?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  devices      Device[]
  sessions     Session[]
  otps         OTPVerification[]

  @@map("users")
}

model Device {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint String
  name        String?
  isTrusted   Boolean   @default(false)
  trustedAt   DateTime?
  lastSeenAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  sessions    Session[]

  @@unique([userId, fingerprint])
  @@map("devices")
}

// ─────────────────────────────────────────
// P1 SKELETON MODELS (fields added per phase)
// ─────────────────────────────────────────

model Department {
  id                  String       @id @default(cuid())
  name                String       @unique
  code                String       @unique
  headId              String?
  head                Employee?    @relation("DepartmentHead", fields: [headId], references: [id])
  parentDepartmentId  String?
  parentDepartment    Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  childDepartments    Department[] @relation("DepartmentHierarchy")
  employees           Employee[]   @relation("EmployeeDepartment")
  designations        Designation[]
  jobs Job[]
  transfersFrom TransferRequest[] @relation("TransferFrom")
  transfersTo   TransferRequest[] @relation("TransferTo")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@map("departments")
}

model Designation {
  id            String       @id @default(cuid())
  title         String
  departmentId  String
  department    Department   @relation(fields: [departmentId], references: [id])
  grade         String?
  band          String?
  employees     Employee[]
  createdAt     DateTime     @default(now())

  @@unique([title, departmentId])
  @@map("designations")
}

enum OtpType {
  EMAIL_OTP
  TOTP
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String?
  device       Device?   @relation(fields: [deviceId], references: [id])
  refreshToken String    @unique
  ipAddress    String
  userAgent    String
  isActive     Boolean   @default(true)
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  @@index([userId])
  @@map("sessions")
}

model OTPVerification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  type      OtpType
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, type])
  @@map("otp_verifications")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  HOLIDAY
  WFH
  ON_LEAVE
}

enum CheckInMethod {
  WEB
  MOBILE
  MANUAL
}

model AttendanceRecord {
  id                String           @id @default(cuid())
  employeeId        String
  employee          Employee         @relation(fields: [employeeId], references: [id])
  date              DateTime         @db.Date
  checkInTime       DateTime?
  checkOutTime      DateTime?
  workHours         Decimal?         @db.Decimal(5, 2)
  overtime          Decimal?         @db.Decimal(5, 2)
  status            AttendanceStatus @default(PRESENT)
  checkInMethod     CheckInMethod?
  checkInIp         String?
  isRegularized     Boolean          @default(false)
  regularizedById   String?
  regularizedBy     Employee?        @relation("AttendanceRegularizer", fields: [regularizedById], references: [id])
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId, date])
  @@map("attendance_records")
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveType {
  id                      String          @id @default(cuid())
  name                    String          @unique
  code                    String          @unique
  maxDaysPerYear          Decimal         @db.Decimal(4, 1)
  isCarryForwardAllowed   Boolean         @default(false)
  maxCarryForwardDays     Decimal?        @db.Decimal(4, 1)
  isPaidLeave             Boolean         @default(true)
  requiresDocumentAbove   Decimal?        @db.Decimal(4, 1)   // e.g. sick leave > 2 days needs doc
  isActive                Boolean         @default(true)
  balances                LeaveBalance[]
  requests                LeaveRequest[]
  createdAt               DateTime        @default(now())

  @@map("leave_types")
}

model LeaveBalance {
  id           String    @id @default(cuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  leaveTypeId  String
  leaveType    LeaveType @relation(fields: [leaveTypeId], references: [id])
  year         Int
  allocated    Decimal   @db.Decimal(4, 1)
  used         Decimal   @default(0) @db.Decimal(4, 1)
  pending      Decimal   @default(0) @db.Decimal(4, 1)
  carriedOver  Decimal   @default(0) @db.Decimal(4, 1)
  updatedAt    DateTime  @updatedAt

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id                String              @id @default(cuid())
  employeeId        String
  employee          Employee            @relation("LeaveRequester", fields: [employeeId], references: [id])
  leaveTypeId       String
  leaveType         LeaveType           @relation(fields: [leaveTypeId], references: [id])
  startDate         DateTime            @db.Date
  endDate           DateTime            @db.Date
  isHalfDay         Boolean             @default(false)
  halfDaySession    String?             // FIRST_HALF | SECOND_HALF
  totalDays         Decimal             @db.Decimal(4, 1)
  reason            String
  attachmentUrl      String?
  status            LeaveRequestStatus  @default(PENDING)
  appliedAt         DateTime            @default(now())
  approverId        String?
  approver          Employee?           @relation("LeaveApprover", fields: [approverId], references: [id])
  approvedAt        DateTime?
  rejectionReason   String?
  workflowInstanceId String?

  @@index([employeeId, status])
  @@map("leave_requests")
}

enum AssetCategory {
  LAPTOP
  DESKTOP
  MONITOR
  MOBILE_DEVICE
  SIM
  ACCESS_CARD
  SOFTWARE_LICENCE
  CLOUD_ACCOUNT
  OTHER
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  LOST
  DAMAGED
  REPLACED
  RETIRED
}

model Asset {
  id              String          @id @default(cuid())
  assetTag        String          @unique
  name            String
  category        AssetCategory
  brand           String?
  model           String?
  serialNumber    String?         @unique
  purchaseDate    DateTime?       @db.Date
  purchaseCost    Decimal?        @db.Decimal(10, 2)
  status          AssetStatus     @default(AVAILABLE)
  currentHolderId String?
  currentHolder   Employee?       @relation("CurrentAssetHolder", fields: [currentHolderId], references: [id])
  notes           String?
  assignments     AssetAssignment[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("assets")
}

model AssetAssignment {
  id                String    @id @default(cuid())
  assetId           String
  asset             Asset     @relation(fields: [assetId], references: [id])
  employeeId        String
  employee          Employee  @relation("AssetAssignmentEmployee", fields: [employeeId], references: [id])
  assignedById      String
  assignedBy        Employee  @relation("AssetAssigner", fields: [assignedById], references: [id])
  assignedAt        DateTime  @default(now())
  returnedAt        DateTime?
  returnedCondition String?
  notes             String?

  @@map("asset_assignments")
}

enum NotificationType {
  APPROVAL_ALERT
  POLICY_UPDATE
  BIRTHDAY
  ANNIVERSARY
  SYSTEM_ALERT
  SECURITY_ALERT
  LEAVE_STATUS
  ASSET_STATUS
  GENERAL
}

model Notification {
  id           String            @id @default(cuid())
  recipientId  String
  recipient    Employee          @relation(fields: [recipientId], references: [id])
  type         NotificationType
  title        String
  body         String
  data         Json?
  isRead       Boolean           @default(false)
  readAt       DateTime?
  createdAt    DateTime          @default(now())

  @@index([recipientId, isRead])
  @@map("notifications")
}

enum WorkflowType {
  LEAVE
  ASSET_REQUEST
  RECRUITMENT
  PROMOTION
  OFFBOARDING
}

enum WorkflowInstanceStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  CANCELLED
}

model Workflow {
  id         String                @id @default(cuid())
  name       String
  type       WorkflowType          @unique
  steps      Json                  // array of {stepIndex, approverRole, isOptional}
  isActive   Boolean               @default(true)
  instances  WorkflowInstance[]
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@map("workflows")
}

model WorkflowInstance {
  id                String                  @id @default(cuid())
  workflowId        String
  workflow          Workflow                @relation(fields: [workflowId], references: [id])
  resourceType      String                  // e.g. "LeaveRequest", "AssetAssignment"
  resourceId        String
  currentStepIndex  Int                     @default(0)
  status            WorkflowInstanceStatus  @default(PENDING)
  initiatedById     String
  initiatedBy       Employee                @relation(fields: [initiatedById], references: [id])
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([resourceType, resourceId])
  @@map("workflow_instances")
}

enum KnowledgeCategory {
  POLICY
  SOP
  ARCHITECTURE
  TECHNICAL_DOC
  HR_GUIDELINES
  TRAINING_MATERIAL
  COMPLIANCE
}

model KnowledgeDoc {
  id            String             @id @default(cuid())
  title         String
  slug          String             @unique
  category      KnowledgeCategory
  content       String             // Markdown or rich text body
  authorId      String
  author        Employee           @relation(fields: [authorId], references: [id])
  version       String             @default("1.0")
  isPublished   Boolean            @default(false)
  publishedAt   DateTime?
  searchVector  Unsupported("tsvector")?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@map("knowledge_docs")
}

// APPEND-ONLY TABLE. Never UPDATE or DELETE rows in this table from
// application code. Only audit.service.ts may INSERT into this table.
model AuditLog {
  id            String    @id @default(cuid())
  actorId       String?
  actor         Employee? @relation(fields: [actorId], references: [id])
  action        String    // e.g. "LEAVE_APPROVED", "EMPLOYEE_UPDATED"
  resource      String    // e.g. "LeaveRequest", "Employee"
  resourceId    String
  oldValue      Json?
  newValue      Json?
  ipAddress     String?
  deviceId      String?
  userAgent     String?
  requestId     String
  performedAt   DateTime  @default(now())

  @@index([resource, resourceId])
  @@index([actorId])
  @@index([performedAt])
  @@map("audit_logs")
}

enum ErasureRequestStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

enum GrievanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model ConsentLog {
  id            String    @id @default(cuid())
  employeeId    String
  employee      Employee  @relation("ConsentSubject", fields: [employeeId], references: [id])
  purpose       String    // e.g. "payroll_processing", "attendance_tracking"
  consentedAt   DateTime  @default(now())
  revokedAt     DateTime?
  collectedById String
  collectedBy   Employee  @relation("ConsentCollector", fields: [collectedById], references: [id])
  ipAddress     String
  notes         String?

  @@map("consent_logs")
}

model DataErasureRequest {
  id             String                @id @default(cuid())
  employeeId     String
  employee       Employee              @relation("ErasureSubject", fields: [employeeId], references: [id])
  requestedAt    DateTime              @default(now())
  requestedById  String
  requestedBy    Employee              @relation("ErasureRequester", fields: [requestedById], references: [id])
  status         ErasureRequestStatus  @default(PENDING)
  approvedById   String?
  approvedBy     Employee?             @relation("ErasureApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  processedAt    DateTime?
  fieldsErased   Json?
  notes          String?

  @@map("data_erasure_requests")
}

model GrievanceCase {
  id          String           @id @default(cuid())
  employeeId  String
  employee    Employee         @relation("GrievanceSubject", fields: [employeeId], references: [id])
  description String
  officerId   String?
  officer     Employee?        @relation("GrievanceOfficer", fields: [officerId], references: [id])
  status      GrievanceStatus  @default(OPEN)
  resolution  String?
  openedAt    DateTime         @default(now())
  resolvedAt  DateTime?

  @@map("grievance_cases")
}

model AppSetting {
  id           String    @id @default(cuid())
  key          String    @unique
  value        Json
  category     String    // e.g. "compliance", "notifications", "company"
  updatedById  String?
  updatedBy    Employee? @relation(fields: [updatedById], references: [id])
  updatedAt    DateTime  @updatedAt

  @@map("app_settings")
}

// ─────────────────────────────────────────
// PHASE 2 SKELETON MODELS
// ─────────────────────────────────────────

enum PayrollRunStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PayrollLineItemStatus {
  PENDING
  PROCESSED
  FAILED
}

// @phase P2 — schema defined now, no application code until Phase 2 is enabled
model SalaryStructure {
  id                String    @id @default(cuid())
  employeeId        String
  employee          Employee  @relation(fields: [employeeId], references: [id])
  ctc               Decimal   @db.Decimal(12, 2)
  basicSalary       Decimal   @db.Decimal(12, 2)
  hra               Decimal   @db.Decimal(12, 2)
  specialAllowance  Decimal   @db.Decimal(12, 2)
  pfEligible        Boolean   @default(true)
  esiEligible       Boolean   @default(false)
  effectiveFrom     DateTime  @db.Date
  createdById       String
  createdBy         Employee  @relation("SalaryStructureCreator", fields: [createdById], references: [id])
  createdAt         DateTime  @default(now())

  @@map("salary_structures")
}

// @phase P2 — schema defined now, no application code until Phase 2 is enabled
model PayrollRun {
  id              String            @id @default(cuid())
  month           Int
  year            Int
  status          PayrollRunStatus  @default(PENDING)
  startedAt       DateTime?
  completedAt     DateTime?
  failedAt        DateTime?
  failureReason   String?
  processedCount  Int               @default(0)
  totalAmount     Decimal?          @db.Decimal(14, 2)
  bankFileName    String?
  initiatedById   String
  initiatedBy     Employee          @relation(fields: [initiatedById], references: [id])
  lineItems       PayrollLineItem[]
  reimbursements Reimbursement[]

  @@unique([month, year])
  @@map("payroll_runs")
}

// @phase P2 — schema defined now, no application code until Phase 2 is enabled
model PayrollLineItem {
  id                 String                  @id @default(cuid())
  payrollRunId       String
  payrollRun         PayrollRun              @relation(fields: [payrollRunId], references: [id])
  employeeId         String
  employee           Employee                @relation(fields: [employeeId], references: [id])
  grossSalary        Decimal                 @db.Decimal(12, 2)
  basicSalary        Decimal                 @db.Decimal(12, 2)
  hra                Decimal                 @db.Decimal(12, 2)
  specialAllowance   Decimal                 @db.Decimal(12, 2)
  pfEmployee         Decimal                 @db.Decimal(10, 2)
  pfEmployer         Decimal                 @db.Decimal(10, 2)
  esi                Decimal                 @db.Decimal(10, 2)
  professionalTax    Decimal                 @db.Decimal(10, 2)
  tds                Decimal                 @db.Decimal(10, 2)
  totalDeductions    Decimal                 @db.Decimal(10, 2)
  netSalary          Decimal                 @db.Decimal(12, 2)
  bankAccountEnc     String                  // AES-256-GCM encrypted
  ifscCode           String
  status             PayrollLineItemStatus   @default(PENDING)
  payslipUrl         String?

  @@unique([payrollRunId, employeeId])
  @@map("payroll_line_items")
}

enum ReimbursementStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

// @phase P2 — schema defined now, no application code until Phase 2 is enabled
model Reimbursement {
  id             String                @id @default(cuid())
  employeeId     String
  employee       Employee              @relation(fields: [employeeId], references: [id])
  category       String
  amount         Decimal               @db.Decimal(10, 2)
  description    String
  receiptUrl     String?
  status         ReimbursementStatus   @default(PENDING)
  approverId     String?
  approver       Employee?             @relation("ReimbursementApprover", fields: [approverId], references: [id])
  payrollRunId   String?
  payrollRun     PayrollRun?           @relation(fields: [payrollRunId], references: [id])
  createdAt      DateTime              @default(now())

  @@map("reimbursements")
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  ON_HOLD
}

enum CandidateStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  JOINED
  REJECTED
}

enum InterviewType {
  PHONE
  VIDEO
  IN_PERSON
  TECHNICAL
  HR
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InterviewRecommendation {
  STRONG_YES
  YES
  NO
  STRONG_NO
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

// @phase P2 — schema defined now, no application code until Phase 2 is enabled
model Job {
  id                String       @id @default(cuid())
  title             String
  departmentId      String
  department        Department   @relation(fields: [departmentId], references: [id])
  hiringManagerId   String
  hiringManager     Employee     @relation(fields: [hiringManagerId], references: [id])
  jobDescription    String
  requiredSkills    String[]
  minExperience     Int
  maxExperience     Int
  ctcMin            Decimal?     @db.Decimal(12, 2)
  ctcMax            Decimal?     @db.Decimal(12, 2)
  openPositions     Int          @default(1)
  filledPositions   Int          @default(0)
  status            JobStatus    @default(DRAFT)
  targetDate        DateTime?    @db.Date
  candidates        Candidate[]
  talentApplications TalentApplication[]
  createdAt         DateTime     @default(now())

  @@map("jobs")
}

// @phase P2 — schema defined now, no application code until Phase 2 is enabled
model Candidate {
  id              String          @id @default(cuid())
  jobId           String
  job             Job             @relation(fields: [jobId], references: [id])
  name            String
  email           String
  phone           String
  resumeUrl       String?
  currentStage    CandidateStage  @default(APPLIED)
  sourceChannel   String?
  skills          String[]
  currentCTC      Decimal?        @db.Decimal(12, 2)
  expectedCTC     Decimal?        @db.Decimal(12, 2)
  noticePeriod    Int?
  interviews      Interview[]
  offer           Offer?
  appliedAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("candidates")
}

// @phase P2 — schema defined now, no application code until Phase 2 is enabled
model Interview {
  id               String                    @id @default(cuid())
  candidateId      String
  candidate        Candidate                 @relation(fields: [candidateId], references: [id])
  interviewerId    String
  interviewer      Employee                  @relation(fields: [interviewerId], references: [id])
  scheduledAt      DateTime
  type             InterviewType
  status           InterviewStatus           @default(SCHEDULED)
  feedback         String?
