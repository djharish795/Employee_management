{
  "name": "@naprocs/database",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "generate": "prisma generate",
    "migrate:dev": "dotenv -e ../../apps/api/.env -e ../../apps/api/.env.local -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../apps/api/.env -e ../../apps/api/.env.local -- prisma migrate deploy",
    "seed": "dotenv -e ../../apps/api/.env -e ../../apps/api/.env.local -- tsx prisma/seeds/seed.ts",
    "studio": "dotenv -e ../../apps/api/.env -e ../../apps/api/.env.local -- prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "bcrypt": "^5.1.1",
    "dotenv-cli": "^8.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5"
  }
}
