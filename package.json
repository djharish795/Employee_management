{
  "name": "naprocs-ems",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @naprocs/database generate",
    "db:migrate": "pnpm --filter @naprocs/database migrate:dev",
    "db:deploy": "pnpm --filter @naprocs/database migrate:deploy",
    "db:seed": "pnpm --filter @naprocs/database seed"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "turbo": "^2.3.3",
    "typescript": "^5.4.5"
  }
}
