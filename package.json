{
  "name": "naprocs-ems",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @naprocs/database generate",
    "db:migrate": "pnpm --filter @naprocs/database migrate:dev",
    "db:deploy": "pnpm --filter @naprocs/database migrate:deploy",
    "db:seed": "pnpm --filter @naprocs/database seed"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "turbo": "^2.3.3",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.1096.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1096.0",
    "@aws-sdk/client-ec2": "^3.1096.0",
    "@aws-sdk/client-ecs": "^3.1096.0",
    "@aws-sdk/client-secrets-manager": "^3.1096.0",
    "@aws-sdk/client-servicediscovery": "^3.1096.0",
    "@naprocs/database": "workspace:^",
    "@types/multer": "^2.2.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "sharp": "^0.35.3"
  }
}
